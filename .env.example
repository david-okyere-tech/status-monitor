# Status Monitor - Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# These are used by the --email alert feature.

# SMTP server configuration
# Defaults are shown below — only change if you're not using Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true

# SMTP credentials (required for email alerts)
# For Gmail, you MUST use an App Password:
# https://myaccount.google.com/apppasswords
SMTP_USER=yourbot@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
