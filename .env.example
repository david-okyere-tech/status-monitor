# Status Monitor - Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# A .env file in the working directory is loaded automatically.
# Existing environment variables win. systemd can also load this
# file with EnvironmentFile= (see status-monitor.service).
#
# These are used by the --email alert feature.

# SMTP server configuration
# Defaults are shown below — only change if you're not using Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true

# SMTP credentials (required for email alerts)
# For Gmail, you MUST use an App Password:
# https://myaccount.google.com/apppasswords
SMTP_USER=yourbot@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Optional generic webhook (Slack and Discord URLs are detected).
# Prefer putting webhooks in the config file when you have more than one.
# WEBHOOK_URL=https://example.com/hooks/status
