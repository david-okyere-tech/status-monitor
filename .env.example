# Status Monitor - Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# These are used by the --email alert feature (Gmail SMTP).

# Gmail address to send alerts FROM
SMTP_USER=yourbot@gmail.com

# Gmail App Password (NOT your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# Use the 16-character password with or without spaces.
SMTP_PASS=abcd efgh ijkl mnop
