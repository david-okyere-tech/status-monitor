[Unit]
Description=Status Monitor — website uptime monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=statusmonitor
Group=statusmonitor
WorkingDirectory=/opt/status-monitor

# Install the package into the venv first: pip install .
# EDIT THIS: change the URL, or switch to --config /opt/status-monitor/config.yaml
ExecStart=/opt/status-monitor/venv/bin/status-monitor \
    --url https://example.com \
    --interval 60 \
    --email alerts@example.com
# Status page (optional): add --web --web-host 127.0.0.1 --web-port 8080

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Load SMTP credentials from a separate file (recommended).
# This keeps credentials out of `systemctl show` output.
# Copy .env.example to /opt/status-monitor/.env and fill in your values.
EnvironmentFile=/opt/status-monitor/.env

# Basic systemd hardening
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/status-monitor/logs

[Install]
WantedBy=multi-user.target
