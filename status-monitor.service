[Unit]
Description=Status Monitor — website uptime monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=statusmonitor
Group=statusmonitor
WorkingDirectory=/opt/status-monitor
ExecStart=/opt/status-monitor/venv/bin/python status_monitor.py --url https://example.com --interval 60 --email alerts@example.com
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment — set SMTP credentials here or use an EnvironmentFile
# Environment="SMTP_HOST=smtp.gmail.com"
# Environment="SMTP_PORT=587"
# Environment="SMTP_USER=yourbot@gmail.com"
# Environment="SMTP_PASS=your-app-password"
# Environment="SMTP_TLS=true"

# Or use a separate env file:
# EnvironmentFile=/opt/status-monitor/.env

[Install]
WantedBy=multi-user.target
